# Generated recomp ports live here and are NEVER committed.
# They contain game-derived code and data.
/projects/

# Build output. The glob matters: a second build tree such as build-sdl/ is
# just as unwelcome as build/.
/build*/
/out/
cmake-build-*/
_deps/
.ninja_*
*.ninja

# Generated intermediates
/generated/
*.o
*.obj
*.a
*.lib
*.exe
*.pdb
*.ilk

# Game data, ROMs and vendor media must never be committed.
*.iso
*.ISO
*.dms
*.ipf
*.lha
*.lzx
*.adf
*.crdownload
*.part
*.ipf
*.hdf
*.rom
*.uss
*.snapshot
capture/

# Python bytecode
__pycache__/
*.pyc

# Screenshots and captures produced by running a port. Derived from game data.
*.ppm
*.png
*.bin.toml
# Stray numeric files from a mistyped command-line argument.
/[0-9]*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
compile_commands.json

# Amiga NDK / Developer CD content is Commodore/Hyperion copyright and must
# never be committed. The shim generator reads a user-supplied local copy and
# writes only into projects/, which is already ignored.
*.fd
*.FD
/ndk/
/NDK/
amiga-dev/
